# Copy to .env and fill in. Never commit real values. Do not put secrets in code.

# sqlite = local offline data (default). bigquery = your GCP project.
POC_BACKEND=sqlite

# BigQuery (only when POC_BACKEND=bigquery)
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=retail_returns_poc

# Service account key file for BigQuery and Vertex AI. Keep the file outside the project folder.
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini. Use one of these:
#   GOOGLE_API_KEY=...                       (Gemini Developer API)
#   GOOGLE_GENAI_USE_VERTEXAI=true           (Vertex AI; also set GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION)
# Verified: Vertex AI with gemini-3.8-flash in location global.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Embeddings: local = offline hashed baseline (default). gemini = Gemini embedding model.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-004

# Limits
# 20 and 300 worked for the example questions (each model call takes several seconds).
MAX_LLM_CALLS=20
REQUEST_TIMEOUT_S=300
LOG_LEVEL=INFO
